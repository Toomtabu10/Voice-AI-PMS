# LLM Configuration - Switch provider/model/key here only. No code changes needed.
# Supported via LiteLLM: openai/gpt-4o, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-20241022,
# xai/grok-beta, ollama/llama3.2, groq/llama-3.3-70b-versatile, etc.
# See https://docs.litellm.ai/docs/providers

LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key
# XAI_API_KEY=xai-your-key
# GROQ_API_KEY=gsk-your-key
# OLLAMA_API_BASE=http://localhost:11434  # for local Ollama

# App settings
DATABASE_URL=sqlite:///./data/patient_records.db
UPLOAD_DIR=./uploads
SECRET_KEY=change-this-to-a-random-secret-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
